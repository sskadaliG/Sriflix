# Server-only secrets (used by the /api serverless functions, never sent to the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
TMDB_READ_TOKEN=
# Upstash Redis (free tier) for per-user AI search rate limits: console.upstash.com > database > REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Firebase web config (public by design, from Firebase console > Project settings)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
